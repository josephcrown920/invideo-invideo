{
  "name": "lantern",
  "private": true,
  "version": "0.1.0",
  "description": "Lantern — general AI video creation SaaS",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lantern/db generate",
    "db:migrate": "pnpm --filter @lantern/db migrate",
    "db:seed": "pnpm --filter @lantern/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  }
}
